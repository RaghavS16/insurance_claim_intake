# ==============================================================================
# Insurance Claim Intake — Environment Variables Template
# ==============================================================================

# Database Connection (PostgreSQL for development/production, SQLite supported in unit tests)
DATABASE_URL=postgresql://postgres:DBpassword@localhost:5433/insurance_claims

# Local Ollama LLM Configuration (Review 1 extraction & conversational fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Voice Pipeline (TTS)
# Path to Piper binary (if not on system PATH) and path to downloaded ONNX voice model
PIPER_BIN=piper
PIPER_VOICE_MODEL=en_US-lessac-medium.onnx

# Application Configuration
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000

# AWS S3 Storage (Review 2 / Review 3: Document uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=your_claim_documents_bucket
AWS_REGION=ap-south-1
AWS_S3_PUBLIC_URLS=false
