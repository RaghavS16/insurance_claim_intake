# =============================================================================
# IntelliClaim Backend — Environment Variables Template
# Copy this file to backend/.env and configure values for your deployment.
# NEVER commit real credentials or .env files to source control.
# =============================================================================

# ==============================================================================
# 1. ENVIRONMENT, STARTUP SPEED & CORE SECURITY
# ==============================================================================
PYTHON_VERSION=3.11.9
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=<generate-64-char-hex-via-openssl-rand-hex-32>
BCRYPT_ROUNDS=10
VERIFY_MIGRATIONS_ON_STARTUP=false
REQUIRE_MIGRATIONS_IN_PRODUCTION=false
RUN_EMBEDDED_OUTBOX_WORKER=true
OUTBOX_POLL_INTERVAL_SECONDS=15
REQUIRE_REDIS_IN_PRODUCTION=true
SECURITY_FAIL_CLOSED=false
NLTK_DATA=/tmp/nltk_data
REQUIRE_S3_IN_PRODUCTION=true
REQUIRE_MALWARE_SCAN=false
REQUIRE_EMAIL_VERIFICATION=true
VOICE_ENABLED=false

# ==============================================================================
# 2. FRONTEND URL & CORS ORIGINS (No trailing slashes, no [brackets])
# ==============================================================================
PUBLIC_APP_URL=https://intelliclaim.vercel.app
ALLOWED_ORIGINS=https://intelliclaim.vercel.app

# ==============================================================================
# 3. DATABASE (Supabase PostgreSQL Pooler - Port 5432 Session Mode + pgvector)
# ==============================================================================
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ==============================================================================
# 4. REDIS (Upstash Serverless Redis - TLS rediss://)
# ==============================================================================
REDIS_URL=rediss://default:[UPSTASH-PASSWORD]@[ENDPOINT].upstash.io:6379

# ==============================================================================
# 5. OBJECT STORAGE (Supabase S3-Compatible Storage)
# ==============================================================================
S3_BUCKET=intelliclaim-evidence
S3_ENDPOINT_URL=https://[PROJECT-REF].supabase.co/storage/v1/s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=[SUPABASE-S3-ACCESS-KEY-ID]
AWS_SECRET_ACCESS_KEY=[SUPABASE-S3-SECRET-ACCESS-KEY]

# ==============================================================================
# 6. RAG VECTOR EMBEDDINGS (768-Dim pgvector — Zero Container RAM Overhead!)
# ==============================================================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=30
# Optional dedicated key for embeddings (otherwise automatically reuses GEMINI_API_KEY):
EMBEDDING_API_KEY=

# ==============================================================================
# 7. MULTI-PROVIDER LLM ROUTER (Zero-Wait Failover + Multi-Key Rotation)
# Supply comma-separated keys in GROQ_API_KEY, GEMINI_API_KEY, and HF_TOKEN
# to multiply your free-tier RPM/TPD capacity with 0ms circuit-breaker failover!
# ==============================================================================
LLM_PROVIDER=groq
FAST_LLM_PROVIDER=groq
FAST_LLM_MODEL=llama-3.1-8b-instant
REASONING_LLM_PROVIDER=groq
REASONING_LLM_MODEL=llama-3.3-70b-versatile

GROQ_API_KEY=gsk_your_primary_groq_key,gsk_your_second_groq_key
GEMINI_API_KEY=AIzaSy_your_primary_gemini_key,AIzaSy_your_second_gemini_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
HF_TOKEN=hf_your_primary_huggingface_token

AI_ALLOW_LOCAL_FALLBACK=false
AI_REQUIRE_MODEL_GOVERNANCE_IN_PRODUCTION=true
AI_ALLOWED_MODELS=openai/gpt-oss-20b:groq,openai/gpt-oss-20b,openai/gpt-oss-120b:groq,openai/gpt-oss-120b,llama-3.3-70b-versatile,llama-3.1-8b-instant,gemini-2.5-flash,gemini-2.5-flash-lite,Qwen/Qwen2.5-72B-Instruct,Qwen/Qwen2.5-7B-Instruct,meta-llama/Llama-3.3-70B-Instruct,Qwen/Qwen2.5-72B-Instruct:together

# ==============================================================================
# 8. FAST HTTPS PORT-443 EMAIL DELIVERY (Fixes 46.5s Cloud SMTP Port-587 Hang!)
# ==============================================================================
BREVO_API_KEY=xkeysib-your-free-brevo-api-key
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-verified-sender@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM_EMAIL=your-verified-sender@gmail.com
SMTP_FROM_NAME=IntelliClaim AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=4
