# ==============================================================================
# Insurance Claim Intake — Environment Configuration (Phase 1)
# ==============================================================================

# Environment Mode: development | staging | production | test
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# Database Connection
# PostgreSQL for dev/production; SQLite is automatically used in unit test runner
DATABASE_URL=postgresql://postgres:DBpassword@localhost:5433/insurance_claims

# LLM & Extraction (Local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Voice Pipeline
# STT: faster-whisper (model sizes: tiny, base, small, medium, large-v3)
STT_MODEL_SIZE=small

# TTS: Piper neural TTS
PIPER_BIN=piper
PIPER_VOICE_MODEL=en_US-lessac-medium.onnx

# VAD: WebRTC Voice Activity Detection aggressiveness (0 = least aggressive, 3 = most aggressive)
VAD_AGGRESSIVENESS=1

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
