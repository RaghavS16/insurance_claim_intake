# =============================================================================
# IntelliClaim Backend — Environment Variables Template
# Copy this file to backend/.env and configure values for your deployment.
# NEVER commit real credentials or .env files to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Application & Server Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS_LONG
PUBLIC_APP_URL=https://claims.example.com
ALLOWED_ORIGINS=https://claims.example.com
FORWARDED_ALLOW_IPS=127.0.0.1
ENABLE_API_DOCS=false

# Session and Access Token Durations
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CLAIM_SLA_HOURS=72

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@localhost:5433/insurance_claims
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# 3. Redis Caching & Rate Limiting
# -----------------------------------------------------------------------------
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@localhost:6379/0
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# 4. Production Security & Guardrails
# -----------------------------------------------------------------------------
ALLOW_INSECURE_TEST_AUTH=false
SECURITY_FAIL_CLOSED=true
REQUIRE_REDIS_IN_PRODUCTION=true
REQUIRE_S3_IN_PRODUCTION=true
REQUIRE_MALWARE_SCAN=true
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_MIGRATIONS_IN_PRODUCTION=true
RUN_EMBEDDED_OUTBOX_WORKER=true

# -----------------------------------------------------------------------------
# 5. Email (SMTP / Mailpit) & OTP Settings
# -----------------------------------------------------------------------------
# In production/staging, EMAIL_BACKEND must be 'smtp'. In development/test, 'mailpit' is allowed.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=claims@example.com
SMTP_FROM_NAME=IntelliClaim AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
MAILPIT_API_URL=http://localhost:8025

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
OUTBOX_MAX_ATTEMPTS=12

# -----------------------------------------------------------------------------
# 6. Storage (AWS S3)
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
S3_BUCKET=my-production-insurance-claims-bucket
S3_ENDPOINT_URL=
S3_KNOWLEDGE_PREFIX=knowledge
S3_EVIDENCE_PREFIX=claims
S3_SERVER_SIDE_ENCRYPTION=aws:kms
S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/replace-with-kms-key-id
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_EVIDENCE_UPLOAD_BYTES=26214400
KNOWLEDGE_MAX_UPLOAD_BYTES=157286400

# -----------------------------------------------------------------------------
# 7. Malware Scanning (ClamAV)
# -----------------------------------------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# -----------------------------------------------------------------------------
# 8. LLM Providers & AI Governance
# -----------------------------------------------------------------------------
LLM_PROVIDER=huggingface
FAST_LLM_PROVIDER=huggingface
FAST_LLM_MODEL=openai/gpt-oss-20b:groq
REASONING_LLM_PROVIDER=huggingface
REASONING_LLM_MODEL=openai/gpt-oss-120b:groq
HF_TOKEN=hf_REPLACE_WITH_YOUR_HUGGINGFACE_TOKEN
HF_BASE_URL=https://router.huggingface.co/v1

# Optional Groq Direct / Fallback
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Latency and retry policies
FAST_LLM_TIMEOUT_SECONDS=8
REASONING_LLM_TIMEOUT_SECONDS=20
FAST_LLM_RETRY_ATTEMPTS=1
REASONING_LLM_RETRY_ATTEMPTS=1
LLM_TIMEOUT_SECONDS=8
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BASE_DELAY_SECONDS=0.25

# AI Governance & Tenant Resource Limits
AI_ALLOWED_MODELS=openai/gpt-oss-20b:groq,openai/gpt-oss-120b:groq
AI_ALLOW_LOCAL_FALLBACK=false
AI_REQUIRE_MODEL_GOVERNANCE_IN_PRODUCTION=true
AI_PROMPT_VERSION=v4
AI_MAX_TURNS_PER_TENANT_PER_MINUTE=120
AI_MAX_CONCURRENT_TURNS_PER_TENANT=8
AI_MAX_RAG_REQUESTS_PER_TENANT_PER_MINUTE=120
AI_MAX_ESTIMATED_TOKENS_PER_TENANT_PER_DAY=200000

# -----------------------------------------------------------------------------
# 9. Embedding & RAG
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=30
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# 10. Self-Hosted Pipecat Voice & WebRTC
# -----------------------------------------------------------------------------
VOICE_ENABLED=true
VOICE_PROVIDER=pipecat_local
VOICE_STT_MODEL=Systran/faster-distil-whisper-medium.en
VOICE_STT_DEVICE=auto
VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_LANGUAGE=en
VOICE_STT_NO_SPEECH_PROB=0.4
VOICE_TTS_BASE_URL=http://piper:5001/synthesize
VOICE_TTS_VOICE_ID=en_US-ryan-high
VOICE_LATENCY_TARGET_MS=1800
VOICE_TURN_SILENCE_SECONDS=0.3
VOICE_VAD_STOP_SECONDS=0.65
VOICE_MAX_QUEUED_TURNS=1
VOICE_WEBRTC_CONNECTION_TIMEOUT_SECONDS=60
VOICE_PIPELINE_IDLE_TIMEOUT_SECONDS=300
VOICE_EVENT_STREAM_MAXLEN=1000
MAX_VOICE_SDP_BYTES=262144
MAX_VOICE_SESSION_SECONDS=1800
VOICE_MAX_EVENT_TEXT_CHARS=4000
VOICE_EVENT_RETENTION_SECONDS=86400
VOICE_WORKER_DRAINING=false
VOICE_WORKER_ID=backend-1

# TURN / STUN Infrastructure
VOICE_ICE_SERVERS=stun:stun.l.google.com:19302,turn:turn.example.com:3478
TURN_REALM=turn.example.com
TURN_USERNAME=REPLACE_WITH_TURN_USERNAME
TURN_PASSWORD=REPLACE_WITH_TURN_PASSWORD
TURN_EXTERNAL_IP=
REQUIRE_TURN_IN_PRODUCTION=false

# -----------------------------------------------------------------------------
# 11. Untrusted Document Resource Limits
# -----------------------------------------------------------------------------
MAX_REQUEST_BODY_BYTES=52428800
MAX_PDF_PAGES=200
MAX_IMAGE_PIXELS=40000000
MAX_EXTRACTED_TEXT_CHARS=2000000
MAX_OCR_SECONDS=30
MAX_ARCHIVE_EXPANDED_BYTES=209715200
