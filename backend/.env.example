# Insurance Claim Intake — Environment Configuration
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:DBpassword@localhost:5433/insurance_claims

# LLM / extraction
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud LLM (OpenAI-compatible / OpenRouter / DashScope / Together)
CLOUD_LLM_MODEL=Qwen/Qwen3.5-27B
CLOUD_LLM_BASE_URL=https://openrouter.ai/api/v1
CLOUD_LLM_API_KEY=

# Pipecat voice pipeline
STT_MODEL_SIZE=small
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
VAD_AGGRESSIVENESS=1
PIPER_MODEL_PATH=piper/en_US-ryan-medium.onnx
PIPER_HTTP_URL=http://localhost:5000/synthesize
PIPER_VOICE=en_US-lessac-medium

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# SMTP / password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@insurance-claims.local
SMTP_USE_TLS=True
