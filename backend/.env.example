# =============================================================================
# InsureClaimAI Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Core Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=False                      # Only True in development
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY   # 32+ random bytes (e.g. openssl rand -hex 32)

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5433/insurance_claims

# Connection Pool (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM Provider (choose one)
# ---------------------------------------------------------------------------

# Option A: Local Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Option B: OpenRouter — model fallback protects against a single free-provider 429
# LLM_PROVIDER=cloud
# CLOUD_LLM_MODEL=google/gemma-4-26b-a4b-it:free
# CLOUD_LLM_BASE_URL=https://openrouter.ai/api/v1
# CLOUD_LLM_API_KEY=sk-or-v1-...
# CLOUD_LLM_FALLBACK_MODELS=openrouter/free

# Option C: Cloud (OpenAI-compatible) — uncomment to use
# LLM_PROVIDER=cloud
# CLOUD_LLM_MODEL=gpt-4o-mini
# CLOUD_LLM_BASE_URL=https://api.openai.com/v1
# CLOUD_LLM_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Voice Pipeline (Pipecat)
# ---------------------------------------------------------------------------
STT_MODEL_SIZE=small             # tiny | small | medium | large
STT_DEVICE=cpu                   # cpu | cuda
STT_COMPUTE_TYPE=int8            # int8 | float16
VAD_AGGRESSIVENESS=3             # 0-3 (3 = most aggressive)
PIPER_MODEL_PATH=piper/en_US-ryan-medium.onnx
PIPER_HTTP_URL=
PIPER_VOICE=

# ---------------------------------------------------------------------------
# Email / OTP (SMTP)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password    # Use Gmail App Password - NOT your main password
SMTP_FROM_EMAIL=no-reply@yourdomain.com

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# JWT Tokens
# ---------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10

# Semantic RAG
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-0.6b
EMBEDDING_TIMEOUT_SECONDS=30
RERANK_MODEL=qwen/qwen3-reranker-0.6b
RERANK_TIMEOUT_SECONDS=30

# AWS S3 document/evidence storage
AWS_REGION=eu-north-1
S3_BUCKET=your-insurance-claims-bucket
S3_ENDPOINT_URL=
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
REQUIRE_S3_IN_PRODUCTION=True
# Prefer IAM roles / workload identity. Do not commit AWS access keys.
S3_KNOWLEDGE_PREFIX=knowledge
S3_EVIDENCE_PREFIX=claims
# Use AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or an IAM role in deployment.
