# =============================================================================
# InsureClaimAI Backend — Environment Variables Template
# Copy this file to backend/.env and fill in your deployment values.
# NEVER commit backend/.env or any real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local Docker:
DATABASE_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5433/insurance_claims
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Set this to the real deployed frontend origin(s), comma-separated if supported.
ALLOWED_ORIGINS=https://your-frontend-domain.example

# -----------------------------------------------------------------------------
# LLM — production low-latency + reasoning profiles
# -----------------------------------------------------------------------------
# Claimant conversation/extraction uses the fast model.
FAST_LLM_PROVIDER=huggingface
FAST_LLM_MODEL=openai/gpt-oss-20b:groq

# RAG requirement planning, complex reasoning and adjuster copilot use the
# reasoning model.
REASONING_LLM_PROVIDER=huggingface
REASONING_LLM_MODEL=openai/gpt-oss-120b:groq

# Backward-compatible default used by code paths that request the configured LLM.
LLM_PROVIDER=huggingface

# Hugging Face Inference Providers routes these model calls to Groq.
HF_TOKEN=REPLACE_WITH_HF_TOKEN
HF_BASE_URL=https://router.huggingface.co/v1

# Optional emergency direct-Groq provider (leave unset for normal operation).
# GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Interactive latency/retry policy. Keep retries low on the live conversation path.
FAST_LLM_TIMEOUT_SECONDS=8
REASONING_LLM_TIMEOUT_SECONDS=20
FAST_LLM_RETRY_ATTEMPTS=1
REASONING_LLM_RETRY_ATTEMPTS=1
LLM_TIMEOUT_SECONDS=8
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BASE_DELAY_SECONDS=0.25

# Optional Google Gemini fallback/alternative provider.
# GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_API_KEY
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_MAX_OUTPUT_TOKENS=2048

# Optional local development/offline path.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Optional direct OpenAI-compatible provider (not OpenRouter).
# LLM_PROVIDER=openai
# CLOUD_LLM_MODEL=your-model
# CLOUD_LLM_BASE_URL=https://api.example.com/v1
# CLOUD_LLM_API_KEY=your-api-key

# -----------------------------------------------------------------------------
# Embedding & RAG Configuration
# -----------------------------------------------------------------------------
# OpenRouter is NOT an embeddings provider for this project.
# Recommended production-safe default: local FastEmbed/pgvector.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_TIMEOUT_SECONDS=30
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=30

# Alternative local Ollama embeddings:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text

# Alternative Gemini embeddings:
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# EMBEDDING_MODEL=gemini-embedding-001

# -----------------------------------------------------------------------------
# AWS S3 — evidence and knowledge storage
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=REPLACE_WITH_SESSION_TOKEN
S3_BUCKET=REPLACE_WITH_S3_BUCKET
S3_ENDPOINT_URL=
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
REQUIRE_S3_IN_PRODUCTION=True
S3_KNOWLEDGE_PREFIX=knowledge
S3_EVIDENCE_PREFIX=claims

# Prefer IAM roles/workload identity in cloud deployment. Do not commit keys.

# -----------------------------------------------------------------------------
# Self-hosted Pipecat voice
# Browser media uses WebRTC; Pipecat owns realtime media orchestration.
# STT is local Whisper/faster-whisper; TTS is a separately hosted Piper HTTP service.
# The existing claim agent remains authoritative for all insurance business logic.
# -----------------------------------------------------------------------------
VOICE_ENABLED=True
VOICE_PROVIDER=pipecat_local
VOICE_STT_MODEL=Systran/faster-distil-whisper-medium.en
VOICE_STT_DEVICE=auto
VOICE_STT_COMPUTE_TYPE=int8
VOICE_STT_LANGUAGE=en
VOICE_STT_NO_SPEECH_PROB=0.4
VOICE_TTS_BASE_URL=http://localhost:5001
VOICE_TTS_VOICE_ID=en_US-ryan-high
VOICE_WEBRTC_CONNECTION_TIMEOUT_SECONDS=60
VOICE_PIPELINE_IDLE_TIMEOUT_SECONDS=300
VOICE_EVENT_STREAM_MAXLEN=1000
MAX_VOICE_SDP_BYTES=262144
MAX_VOICE_SESSION_SECONDS=1800

# Piper HTTP server (run separately from the application process):
# uv pip install "piper-tts[http]"
# uv run python -m piper.http_server -m en_US-ryan-high


# -----------------------------------------------------------------------------
# Optional observability / infrastructure
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Production security
REDIS_PASSWORD=change-this-to-a-long-random-secret
REQUIRE_REDIS_IN_PRODUCTION=true
REQUIRE_MIGRATIONS_IN_PRODUCTION=true
REQUIRE_EMAIL_VERIFICATION=true
SECURITY_FAIL_CLOSED=true
MAX_REQUEST_BODY_BYTES=52428800
EMBEDDING_DIMENSION=768

REQUIRE_MALWARE_SCAN=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Production security / governance
S3_SERVER_SIDE_ENCRYPTION=aws:kms
S3_KMS_KEY_ID=
AI_ALLOWED_MODELS=openai/gpt-oss-20b:groq,openai/gpt-oss-120b:groq
AI_ALLOW_LOCAL_FALLBACK=false
AI_REQUIRE_MODEL_GOVERNANCE_IN_PRODUCTION=true
AI_PROMPT_VERSION=v4
AI_MAX_TURNS_PER_TENANT_PER_MINUTE=120
AI_MAX_CONCURRENT_TURNS_PER_TENANT=8
AI_MAX_RAG_REQUESTS_PER_TENANT_PER_MINUTE=120
AI_MAX_ESTIMATED_TOKENS_PER_TENANT_PER_DAY=200000

# Voice production: include a TURN endpoint
VOICE_WORKER_ID=
VOICE_ICE_SERVERS=stun:stun.example.com:3478,turn:turn.example.com:3478
VOICE_EVENT_RETENTION_SECONDS=86400
VOICE_WORKER_DRAINING=false

# WebAuthn / passkeys
PASSKEY_ENABLED=true
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=InsureClaim AI
PASSKEY_ORIGIN=http://localhost:3000
PASSKEY_REQUIRE_USER_VERIFICATION=true
PRIVILEGED_PASSKEY_REQUIRED=true

# Untrusted document resource limits
MAX_PDF_PAGES=200
MAX_IMAGE_PIXELS=40000000
MAX_EXTRACTED_TEXT_CHARS=2000000
MAX_OCR_SECONDS=30
MAX_ARCHIVE_EXPANDED_BYTES=209715200

VOICE_MAX_EVENT_TEXT_CHARS=4000
OUTBOX_MAX_ATTEMPTS=12
