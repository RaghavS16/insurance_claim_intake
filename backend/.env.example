# ==============================================================================
# Insurance Claim Intake — Environment Configuration (Phase 1)
# ==============================================================================

ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:DBpassword@localhost:5433/insurance_claims

# LLM & Extraction
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Pipecat voice pipeline
STT_MODEL_SIZE=small
VAD_AGGRESSIVENESS=1
PIPER_HTTP_URL=http://localhost:5000
PIPER_VOICE=en_US-lessac-medium

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Password Reset Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@insurance-claims.local
SMTP_USE_TLS=True
