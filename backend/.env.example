# =============================================================================
# InsureClaimAI Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Core Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=False                      # Only True in development
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY   # 32+ random bytes (e.g. openssl rand -hex 32)

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5433/insurance_claims

# Connection Pool (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM Provider (choose one)
# ---------------------------------------------------------------------------

# Option A: Local Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Option B: OpenRouter — model fallback protects against a single free-provider 429
# LLM_PROVIDER=cloud
# CLOUD_LLM_MODEL=google/gemma-4-26b-a4b-it:free
# CLOUD_LLM_BASE_URL=https://openrouter.ai/api/v1
# CLOUD_LLM_API_KEY=sk-or-v1-...
# CLOUD_LLM_FALLBACK_MODELS=openrouter/free

# Option C: Cloud (OpenAI-compatible) — uncomment to use
# LLM_PROVIDER=cloud
# CLOUD_LLM_MODEL=gpt-4o-mini
# CLOUD_LLM_BASE_URL=https://api.openai.com/v1
# CLOUD_LLM_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Embedding & RAG Configuration
# OpenRouter is chat/completion only for this project; NEVER configure it as
# EMBEDDING_BASE_URL. Choose a real embedding provider.
# ---------------------------------------------------------------------------
# Option A: local Ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text

# Option B: Gemini embeddings
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-key
# EMBEDDING_MODEL=gemini-embedding-001

# Option C: local FastEmbed
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

EMBEDDING_TIMEOUT_SECONDS=30
RERANK_MODEL=
RERANK_TIMEOUT_SECONDS=30

# AWS S3 document/evidence storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=               # Optional (if using temporary STS credentials)
S3_BUCKET=your-insurance-claims-bucket
S3_ENDPOINT_URL=                   # Optional (e.g. for MinIO / LocalStack / Cloudflare R2)
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
REQUIRE_S3_IN_PRODUCTION=True
# Prefer IAM roles / workload identity. Do not commit AWS access keys.
S3_KNOWLEDGE_PREFIX=knowledge
S3_EVIDENCE_PREFIX=claims
# Use AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or an IAM role in deployment.
