# ==============================================================================
# IntelliClaim Free Demo & Self-Hosted Environment Variables
# ZERO-DOLLAR DEMONSTRATION & LOCAL EVALUATION PROFILE ONLY
# ==============================================================================
# CAUTION:
# This profile is strictly intended for local demonstrations and synthetic
# test data. It disables production malware scanning, uses an unencrypted local
# MinIO bucket, and uses memory/mock email delivery. NEVER USE IN PRODUCTION.
# ==============================================================================

# Core Environment
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=demo-secret-key-at-least-32-characters-for-testing-only
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (pgvector 16) - Bound strictly to 127.0.0.1
POSTGRES_DB=insurance_claims
POSTGRES_USER=postgres
POSTGRES_PASSWORD=demopostgres123
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:demopostgres123@postgres:5432/insurance_claims

# Redis - Bound strictly to 127.0.0.1
REDIS_PASSWORD=demoredispass123
REDIS_PORT=6379
REDIS_URL=redis://:demoredispass123@redis:6379/0

# Private MinIO (S3-Compatible) Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_BUCKET=insurance-claims
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1

# Feature Toggles (Demo Profile)
REQUIRE_REDIS_IN_PRODUCTION=false
REQUIRE_S3_IN_PRODUCTION=false
REQUIRE_MALWARE_SCAN=false
REQUIRE_EMAIL_VERIFICATION=false
REQUIRE_MIGRATIONS_IN_PRODUCTION=false
RUN_EMBEDDED_OUTBOX_WORKER=true
ENABLE_VOICE=false

# AI & LLM Services (Local Ollama or Free Tier)
# For local models via Ollama:
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
FAST_LLM_PROVIDER=ollama
FAST_LLM_MODEL=llama3.2:3b
REASONING_LLM_PROVIDER=ollama
REASONING_LLM_MODEL=llama3.2:3b

# Local Embeddings (FastEmbed - CPU-optimized)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Email Backend (In-Memory Delivery for Demo)
EMAIL_BACKEND=memory

# Optional Caddy Reverse Proxy Domain
DOMAIN=demo.local
