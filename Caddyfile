{$DOMAIN:localhost} {
    encode gzip zstd

    # Route API and WebSocket requests to backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Route OpenAPI docs and health/ready endpoints to backend
    handle /docs* {
        reverse_proxy backend:8000
    }
    handle /redoc* {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }
    handle /ready {
        reverse_proxy backend:8000
    }

    # Route all other web traffic to Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }
}
